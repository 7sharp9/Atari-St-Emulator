<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="MMU.fs" />
    <Compile Include="Instructions.fs" />
    <Compile Include="68k.fs" />
    <Compile Include="Video.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Live SDL2 window (Video.fs), opt-in via the `window` CLI arg. Silk.NET.SDL pulls the
         SDL2 native binary transitively (Ultz.Native.SDL). Headless mode needs none of this. -->
    <PackageReference Include="Silk.NET.SDL" Version="2.22.0" />
  </ItemGroup>

</Project>
