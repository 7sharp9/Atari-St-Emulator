# PowerMonger [cr Replicants] — routine / data symbol table
# addr<TAB>name   (RAM addresses in the relocated game image, base $1050)
# Feed to trace_cfg.py --names. Names are invented for readability; every entry
# is backed by disassembly of scratchpad/pm70_iso.ram and, where marked in the
# .md files, a trace. Grouped by subsystem; keep sorted-ish by address.

# ---- scheduler / sim tick (strategy.md "Where it runs") ----
00013000	pm_tick                 # the ~2.4 Hz simulation tick body (whole thing)
00013040	pm_tick_running         # entered when unpaused + a game is running
000127e6	pm_event_markers        # min-2 selector -> $58058 notification ticker
00006522	pm_cmd_decide           # per-commander order pipeline (the commander AI)
0000d322	pm_force_accum          # per-side troop totals -> $57fba
00003e06	pm_flag_health          # morale->UI + per-objective budget decay + $57fba objective term
0001abaa	pm_sound_ambient        # NOT economy: sound LCG x16 + $ff9e sample mix + one $4d252 wildlife poke. 97th: on each sound-LCG ($57ff6) wrap ($1ac3c) it ALSO rotates $57fd0 = ($57fd0 + 2) & 6 (cycling {0,2,4,6}) -- so g_tileset_sel / the mode-$7c gate is NOT static per mission (~1 rotation / 110M steps in mission 1)
0001abc0	pm_rng_step             # $57fec++ (tick-count "RNG") + $57ff6 sound LCG x=(x*$24a1+$24df)&$1fff
000178ae	pm_render_setup_a       # per-frame render prep (group $4c exec sub-record)
0000f898	pm_render_terrain       # $f97e picks 1 of 4 yaw-quadrant grid-walk handlers by ((yaw+8)>>5)&6; sets $ffa2 = 2*[$ff9e] on first call
0000f986	pm_grid_walk_dispatch_table    # 4 words, offsets from $f986 itself: $8/$114/$22e/$346 -> q0/q1/q2/q3 entry points (NOT the $f98c/$fa98/$fbb2 guesses of earlier passes -- those were the RTS of the PRECEDING handler / a byte inside this table; fixed 83rd via jmp 2(PC,D0.w) at $f982)
0000f98e	pm_grid_walk_q0        # yaw-quadrant 0 ($00/$10/$20/$30), PORTED+trace-verified 83rd (pm83_q0c.ram cell 36,49): no start offset; outer m=0..7 row N->S, inner n=0..7 col W->E; cell(camX+n,camY+m) corner(m,n); flag CLEAR: split C00-C11, sub-order by packed(C00) vs packed(C11); flag SET: unconditional, split C10-C01
0000fa9a	pm_grid_walk_q1        # yaw-quadrant 1 ($40/$50/$60/$70), PORTED+trace-verified 83rd (pm83_q1c.ram cell 40,50): start row7,col0; outer m=0..7 col W->E, inner n=0..7 row S->N; cell(camX+m,camY+7-n) corner(7-n,m); flag CLEAR: unconditional, split C00-C11; flag SET: split C10-C01, sub-order by packed(C01) vs packed(C10)
0000fbb4	pm_grid_walk_q2        # yaw-quadrant 2 ($80/$90/$a0/$b0), PORTED+trace-verified 83rd (pm83_q2c.ram cell 40,47): start row7,col7; outer m=0..7 row S->N, inner n=0..7 col E->W; cell(camX+7-n,camY+7-m) corner(7-m,7-n); flag CLEAR: split C00-C11, sub-order by packed(C00) vs packed(C11); flag SET: unconditional, split C10-C01
0000fccc	pm_grid_walk_q3        # yaw-quadrant 3 (yaw $f0), PORTED+trace-verified 78th: A0=$3f364+$fe02(col7) A1=type plane cam+7; for k,j in 0..7: cell(camX+7-k,camY+j) corner(j,7-k); C00=(A0) C10=4(A0) C01=64(A0) C11=68(A0); $438ee+8257 bit7 = DIAGONAL SELECTOR (clear: C00-C11 split, tri(C10,C11,C00)=type tri(C01,C00,C11)=height; set: C10-C01 split); colour +[$4bb3e]&3 if <$0c
0000fe8e	pm_proj_hbias_calc     # 92nd: HBIAS = min control-plane byte over the (2*half+1)^2 window from A1 -> word[$fec4]; clamp start 127; A1 row stride = width + word[$fdee]
0000fecc	pm_project_grid        # project grid corners -> $3f364 (rotate by $ff9a, perspective divide $ff7c). 92nd RIDER 3b (Proven vs real 68k via callcap, 3240/3240 vertices over 40 states): ENTRY CONTRACT A3 = &t_yaw_sincos ($13f8a); reads 0(A3,yaw*2) & 0(A3+128,yaw*2) for sin/cos, everything else from fixed mem. bare bsr with garbage A3 -> 158/162 wrong. integer recon scratchpad/pm92/proj_ref.py byte-exact, no float. (sym addr was $fec6, 6 low - fixed)
0000ff7c	pm_perspective_div     # sx = x*$ff98/($ff98-z) ; sy = (z-$ff96)*$ff98/($ff98-z)+$ff96 ; in D0=rx D2=ry(depth) D1=z, out D0.w=sx D1.w=sy
0000ef62	pm_tri_raster          # clip vertices (screenX<=255, screenY<=199 -> $f202); cyclic-rotate min-Y to front (NOT a full sort - v1/v2 keep cyclic order); build span record @ $f1e2; FORCE record colour = $1c when vertex1 is already the left edge (general: slope(top->bot) > slope(top->mid); flat-top: sx1<sx0) = the dark coast/front shading (78th, trace-verified); 2 edge slopes via $f000; bra $e3e6. 80th: ported whole as ef62_raster
0000f000	pm_edge_slope          # 16.16 fixed edge slope, sign of dx. steep (dy<=|dx|): ((|dx|<<8)//dy)<<8 (truncates before the <<8); shallow: (|dx|<<16)//dy; V-clamp to exactly $10000. 80th: ported as _fixed_slope in pm_render_ref.py
0000e3e6	pm_span_setup         # fill entry. A5 = ([$ffa2] + record[0]<<8 + ((topY<<4)&ff)) >> 1 = $2e000 + colourByte*128 + (topY&15)*8 (byte-exact vs live $f1e2 record, A5=$2f358 at colour 0x26 topY 75); A1 = backbuf + topY*160
0000e420	pm_span_walker        # DDA span walker: 2 16.16 edge X accumulators (D4 left / D5 right) += slope/scanline; run-stepped (u16 run,i32 slope) stream in A0, the shorter edge reloads slope at its own scanline (record[20]/[22]); $ece2[ix] word-indexed = (ix>>4)*8 cluster byte offset; $ec62/$eca2 partial masks == "draw x iff ixL<=x<=ixR". 80th: the A5 roll ($e44a `add.b #8` on 2*A5) WRAPS mod 128 inside the colour slot -> phase = colourByte*128 + ((8*y) mod 128), live-traced; kills the 79th empirical -1. Ported as _dda_walk, ~94% exact-index
0000e3e2	g_span_drawbuf_ptr     # runtime-patched long BEFORE $e3e6 (movea.l -10(PC)): the $e420 fill target = compose buffer + $20 bytes = +64 screen px (the iso window origin; left 64px is HUD)
0000e4de	pm_span_fill_mid      # Duff device: move.l D0/D1,(A2)+ repeated; D0/D1 = movem.l (A5) = one 16px pattern {planes01, planes23}, tiled; jmp $e52e+(-(width>>1))
0000ec62	t_edge_mask_left      # 16 longs, clear leftmost k bits: ffffffff 7fff7fff ... 00010001; index (D4&30)*2
0000eca2	t_edge_mask_right     # 16 longs, keep leftmost k+1 bits: 80008000 c000c000 ... ffffffff; index (D5&30)*2
0000ece2	t_cluster_byteoff     # words, $ece2[ix] = (ix>>4)*8 = byte offset of the containing 16px cluster in the screen row ([0]*16 [8]*16 [16]*16 ...); A6 base = $ece2 so $ec62 = A6-128, $eca2 = A6-64
0000ffa2	g_dither_base_x2       # = 2 * [$ff9e] = $5c000; $e3e6 does (this + colourByte*256 + ((topY&15)<<4)) >> 1 = $2e000 + colourByte*128 + (topY&15)*8 for the FIRST scanline, then $e420 rolls +8/scanline wrapping mod 128 in the colour slot (80th, live-traced). The raw $5c000 is a DIFFERENT small-int table, used here only as the doubled constant
0000ff9e	g_dither_table_ptr     # long: base of the 4bpp pattern table ($2e000 in pm71/pm74 snaps); ~8.5 KB span for mission 1, absolutely indexed by colourByte*128; also read PC-relative by the sound mixer ($1abaa)
0000ff96	g_proj_horizon         # projection: horizon screen-Y = 130 (PC-relative read in $ff7c: sub 12(PC), add 4(PC))
0000ff98	g_proj_eyedist         # projection: eye distance = 320 (PC-relative read in $ff7c: 26(PC))
0000ff9a	g_cam_yaw              # camera rotation, 16 steps of $10 (& $f0); $fecc indexes $13f8a by yaw*2
0000ff9c	g_zoom_scale           # world-unit scale = $13f83[zoomIndex]; 21 at index 4 ($ff7c/$fecc multiplier)
0000fec4	g_proj_hbias           # dynamic: MIN control-plane height over the visible window ($fe8e), subtracted from cell height before scaling
00013f8a	t_yaw_sincos           # fine sine table: i16[k] = round(32768*sin(k * 0.703125 deg)); $fecc reads [yaw*2] (=P, "sin") and [yaw*2 + $80] (=Q, "cos")
00013f83	t_zoom_ff9c            # data: [_,84,42,28,21,17,14,12] zoom index -> $ff9c
0000fdea	g_zoom_geometry_consts # 13 words $fdea..$fe02 derived by $fe04 from (grid half-extent, tile px); grid-buffer strides + loop bounds + screen offsets
0004bb3a	g_cam_cell_x           # camera grid cell X ($fecc offsets by -$57ffc)
0004bb3c	g_cam_cell_y           # camera grid cell Y
0003f364	g_grid_corner_buf      # projected grid corners, 2 words (screenX,screenY)/vertex, row stride 64 B (9 used at zoom 4); screenX is iso-WINDOW-relative -> final screen X = sx + 64 ($e420 draws to buffer+$20 bytes); $ef62 clips vertices to screenX<=255 / screenY<=199; 80th: pm_render_ref.py --ram (walk_q3 + $ef62 + $e420 DDA) scores ~94% exact / ~95% within-1
0002e000	g_dither_table         # 4bpp pattern table (= [$ff9e]); 80th (live-traced $e420): A5 = $2e000 + colourByte*128 + ((8*y) mod 128) -- the roll wraps INSIDE the 128-B colour slot, never advances to slot cb+1, so the topY term drops out; 128 B/colourByte = 16 8-byte sub-patterns (long0=planes{0,1}, long1=planes{2,3}); 0x24-2c green, 0x08-0b water, 0x18-1c rock; ~8.5 KB span, absolutely indexed
00078000	g_hud_master           # 32000-B HUD + stone border + the pre-rendered OPEN SEA + an island-shaped hole; built once at mission load ($13b9a). $12ce0 copies it -> back buffer ~1/3 frames, then $f898 redraws ONLY the island into the hole. NO per-frame sea fill (79th: composed frame vs this master differ only in the island blob + sprites)
00017878	pm_render_setup_b       # rotation-indexed row table select ($17ad8)
