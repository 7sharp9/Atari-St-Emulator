# PowerMonger [cr Replicants] — routine / data symbol table
# addr<TAB>name   (RAM addresses in the relocated game image, base $1050)
# Feed to trace_cfg.py --names. Names are invented for readability; every entry
# is backed by disassembly of scratchpad/pm70_iso.ram and, where marked in the
# .md files, a trace. Grouped by subsystem; keep sorted-ish by address.

# ---- scheduler / sim tick (strategy.md "Where it runs") ----
00013000	pm_tick                 # the ~2.4 Hz simulation tick body (whole thing)
00013040	pm_tick_running         # entered when unpaused + a game is running
000127e6	pm_event_markers        # min-2 selector -> $58058 notification ticker
00006522	pm_cmd_decide           # per-commander order pipeline (the commander AI)
0000d322	pm_force_accum          # per-side troop totals -> $57fba
00003e06	pm_flag_health          # morale->UI + per-objective budget decay + $57fba objective term
0001abaa	pm_housekeeping         # phase accumulator; gates $57fec++ and the sound LCG
0001abc0	pm_rng_step             # $57fec++ (tick-count "RNG") + $57ff6 sound LCG x=(x*$24a1+$24df)&$1fff
000178ae	pm_render_setup_a       # per-frame render prep (group $4c exec sub-record)
0000f898	pm_render_terrain       # terrain raster driver
00017878	pm_render_setup_b       # rotation-indexed row table select ($17ad8)
000165b2	pm_water_anim           # selected-group water / terrain animation
00014b62	pm_entity_iter          # walk the 511 object records, dispatch each mode (ai.md)
00006a3a	pm_order_exec           # order executor: consume $58016, drive group state + lead mode
00007a56	pm_render_sprites_hud   # sprite / HUD compositor into offscreen+32000
0000d23a	pm_force_ratio          # $57fba -> $57fce UI mood ratio (min(4,(2*mine+enemy/4)/enemy))
00001870	pm_vbl_sync             # per-frame VBL wait / present
00012ce0	pm_blit_to_shifter      # offscreen buffer -> shifter screen (periodic double-buffer flush)

# ---- commander AI internals (strategy.md "$6522") ----
00006564	pm_cmd_synth            # synthesise an order (no queued player order)
0000661a	pm_cmd_primary_slot    # primary objective (i==0): march at nearest enemy leader
000068fe	pm_find_enemy_leader   # nearest enemy leader, weight = $580a6[side].byte16 >> 2
000068ee	pm_score_target        # score ~ (d/2)*(force/8 + 1) vs objective budget 112()
000069b4	pm_find_besiege_target # nearest enemy leader for the $08 besiege path (>=22 troops)
00006762	pm_campaign_hook       # obey $67d0 scripted campaign order if id matches 268()
000067d0	g_campaign_order       # {word0 campaignId, word2 orderType, word4 subMode}; no in-game writer
000067ee	pm_order_pack          # re-pack found leader cell -> {x:6,y:7}
00006822	pm_order_store         # store {type,param} into $58016[cmd], stamp $58042 cross-index
00006888	t_ordertype_groupstate # data: order type -> group state ($06->2 $08->3 $0c->8 ...)

# ---- order executor (strategy.md "$6a3a") ----
00006a80	t_slotstate_dispatch   # data: byte4 slot-state -> handler
00006ac6	pm_order_exec_slot     # one command slot
00006b38	pm_order_dispatch      # read byte1 order type, clear it, jmp $6b5c table
00006b5c	t_ordertype_handler    # data: 26-entry order-type -> handler jump table
00006bec	pm_ord_06_scriptmove
00006c18	pm_ord_08_besiege
00006c4a	pm_ord_0c_march_engage
00006c98	pm_ord_10_regroup
00003154	pm_order_to_cell       # packed cell -> $47970 bucket -> entity; friend/foe by sign(cmdid); -> $4b80
00004b80	pm_commit_group_target # group exec sub-record state=8; lead man -> mode $10 toward cell centre
000037c2	pm_group_path_setup    # validate / path setup for the group lead
000030fe	pm_regroup_split       # order $10: 60(group) fraction
000039d4	pm_regroup_march       # order $10: lead man toward muster
00003c08	pm_besiege_setup       # order $08: group state 3

# ---- force accounting / diplomacy ----
00057fba	g_side_force           # 5 x 4 bytes per-side force totals (rebuilt each tick)
00057fce	g_force_ratio          # UI mood ratio 0..4 (UI only; $6522 never reads it)
000580a6	g_side_assessment      # 5 x $20-byte per-side assessment/relationship blocks
00004bc8	pm_contact_reconcile   # troop-count + relationship reconcile on contact (NOT casualties)
00004c2a	pm_diplo_break         # clear relationship bits in $580a6, notify player ($c5ee), $311a
00004de2	pm_leader_nation       # read a leader's nation byte, D7=2 if it is a leader record
0000311a	pm_assessment_write    # write a side-pair assessment byte in $580a6
0000c5ee	pm_notify_player       # "war has been declared" style player message

# ---- combat (strategy.md "Combat", ai.md "Combat") ----
0001533c	pm_melee               # mode $32 handler: drain target morale (byte45) 1..4/tick; <=0 -> $5590
00005590	pm_kill_or_rout        # morale depleted: roll $30fe (group.field60-2) -> KILL($55f2, corpse) or ROUT($560a, $3c08 scatter)
000056a6	pm_engage              # engagement: dist<$fff + can-fight -> $5778, set mode $32, link attacker
00005778	pm_engage_bookkeep     # contact/ownership bookkeeping (state 6 mark, state $d record, else $4bc8)
000057f0	pm_spawn_projectile    # spawn into $4be00 effect array; vel toward target /$78, life $14, type=D1
0000596a	pm_effect_update       # per-tick projectile loop over $4be00..$4c110; life--; type $12 -> area hit on impact
00016778	pm_bucket_unlink       # remove one object from its $47970 cell chain
00004be00	g_effect_slots         # 48 slots x $10 bytes: projectiles / effects (slot 0 of $4bdf0 = template w/ reload byte)
00015302	pm_reached_enemy       # mode $2e: snap to target, mode $32, maybe $56a6
00003c08	pm_group_restructure   # scatter/rebuild a group after a rout or a lost besiege
00005c80	pm_upkeep              # per-entity upkeep: survivability[flags&$1f] - wear*4 < 0 -> $5bd2; morale += $57fec&1
00005ccc	t_survivability        # data: 17 sparse bytes, flags&$1f in {0,1,2,4,8,$10}->{90,82,69,79,72,95}, else 0; $11->0
00005bd2	pm_unit_remove         # remove a spent unit: decrement leader troops (8($4e514)) or group force (-24($51538)); $5c10
00005c10	pm_unit_to_corpse      # neg byte5, morale 0, category $c, countdown $a0
00005c2c	pm_owner_reconcile     # settlement owner changed -> $4bc8 or adopt owner + $25d6
00001b8c	pm_group_decrement     # -24($51538+grp) -= 1 (committed-force counter) on a follower's death
00001d70	pm_capture_settlement  # garrison hit 0: transfer ownership + procedurally name the territory
000025d6	pm_ui_counter_bump     # bump $12abe/$12acc UI counters, AES/VDI redraw

# ---- entity FSM (ai.md) ----
00051b66	g_object_records       # 511 x 50-byte object records, slots 1..511
00047970	g_cell_buckets         # per-cell entity linked-list heads (broad phase), stride 2
000438ee	g_terrain              # type plane at 0, height/flag plane at +-8257 (dual 8 KB planes)
0004f916	g_nation_table         # 18-byte nation/settlement records
00051538	g_group_orders         # 5 x $13c group-order records
0003f86c	g_cell_control         # per-cell influence/ownership byte
0004e514	g_leader_table         # 32-byte per-lord: troop counts (+6,+8), message counters, name index
000168ee	g_patrol_paths         # {dx,dy} word lists, terminated by a word >= $7d00
00014bb4	t_mode_handlers        # data: mode $00..$94 -> handler word-offset table (handler = $14bb4 + s16 word[$14bb4+mode])
00014c92	h_mode00_idle          # face + fidget -> mode $0a, or mode $8c if order_class $a
00014e70	h_mode0e_patrol        # march the $168ee spline; seg word >=$7d00 = terminator (loop/jump-mode/end)
00014f08	h_mode10_advance       # advance to target_x/y (or chase link_target); probe ahead -> $4a; reached -> $15302
00014ff8	h_mode12_halt          # cool-down dwell -> mode $10
000150c0	h_mode1a_absorb        # group absorbs reinforcements: slice reserve_6 -> march_14 by ($30fe) shift
00015122	h_mode1c_detach        # size a raiding party (troops_8 >> $30fe) -> mode $28 besiege
00015264	h_mode28_besiege       # assault pulse: garrison-- while group state 3; at 0 leader troops-- + $1d70
00015282	h_mode2a_besiege       # $28 variant
0001533c	h_mode32_melee         # = pm_melee
00015b94	h_mode56_regroup       # unpack packed muster cell {x:6,y:7} + $3f86c control byte -> mode $10
00015c46	h_mode5a_proxgate      # wait for a category $18/$20 neighbour in the cell bucket, else timeout -> mode $62
00015d66	h_mode5c_tosettle      # move toward the settlement, re-derive target -> mode $60
00015ddc	h_mode60_register      # arrive: leader.reserve_6 += 4, mode $62
00016048	h_mode68_formation     # follower: $5c80 upkeep only; position stamped by the lead
000161b2	h_mode8a_garrison      # $5c80 upkeep only
0001648e	pm_terrain_sample      # terrain sample at (D6,D7); Z <=> type 0 (water/impassable)
000164bc	pm_step_toward         # one step toward (D0,D1) via divu 16(A1); Z <=> reached
00014262	pm_heading             # (dx,dy) -> 16-dir heading
00012d56	pm_rotate_vec          # rotate (D0,D1) by heading D2 (sin/cos $1400a)
000163ea	pm_relink_bucket       # project entity to screen cell, relink $47970 bucket
00016260	pm_notify_neighbours   # walk cell bucket, bump leader message counters ("under attack")
00016808	pm_target_cell_resolve # resolve a target cell -> entity, used by the projectile spawn

# ---- input / camera (graphics.md) ----
000018be	pm_ikbd_isr            # PM's own IKBD ISR (vector $46)
00013762	pm_camera_keys         # per-frame keypad camera loop (gated on key array slot 54)
00013f60	pm_zoom_set           # zoom preset 1..7 -> $ff9c + jsr $fe04
0000fe04	pm_zoom_geometry      # zoom index -> 13 render constants $fdea..$fe02

# ---- RNG / clocks ----
00057fec	g_tick_rng            # free-running counter, ++ in $1abc0; low bits used as "random" (deterministic)
00057ff6	g_sound_lcg           # 13-bit sound LCG state
0002df70	g_sim_clock           # ++ each running tick
00004bb3e	g_master_tick         # long master tick counter, ++ at $013034
00002df72	g_game_clock          # compared against objective wait-until timestamps
00057fee	g_game_speed          # $57ff0 reload (tick subdivision; 1:1 at normal speed)
00057ff0	g_tick_subdiv         # counts down each $13000; underflow -> present + reload
00057ff2	g_paused              # nonzero = paused (skips the AI + render, not the executor)
00014e4e	g_population          # nonzero = a game is running (set by the briefing OK click)
