00013b9a	pm_world_build         # briefing OK ($b876) -> build the mission. $13be8: $57fd0 := (byte[$58146] & 3)*2. $580a0 != 0 -> $10d1e (mission descriptor as the RNG seed: $10d22 move.l $580a0,$2df84; $12c9a is a 32-bit LCG, so the whole map is a deterministic function of $580a0). Then $2266/$ac20/$1073c/$10058/$4672/$2984/$238c/$2906 nation+placement+objective seeding. 97th: rts at $13ce6
00010d1e	pm_mission_params      # fill $58146.. parameter block (procedural: seed/size/lord count/placement stream)
00002266	pm_place_nations       # consume the $58152 placement stream; arm enemy command slots (slot_state:=4)
00058146	g_world_params         # $58146 seed, $58148 size, $5814a lords, $5814c/e coords, $58150 settlements
000057fd0	g_tileset_sel          # word, initialised at $13b9a ($13be8) to (byte[$58146] & 3) * 2 (= 4 for mission 1). indexes t_prop_tile_offset ($11746) for the byte6 == 4 building/tree frame base, AND (96th) gates the mode-$7c settlement heartbeat -- $157ba/$15042/$15a30/$15b6c route that path only when this == 0. 97th: NOT static -- $1abaa rotates it ($57fd0+2)&6 = {0,2,4,6} on each sound-LCG wrap (~1/110M steps), so mode $7c (and the $163b8 drain + loyalty/revolt) runs in mission 1 in brief intermittent bursts, and the building/tree tile-set shifts with it
0000580a0	g_mission_descriptor   # $584c4 -> here on briefing OK; if != 0, $13b9a takes the defined path ($10d1e parses it); "Between Pages 1-5" -> small procedural descriptor. $5809c overrides $58148 (map size; < $2000 -> "small" preset = ~10-13 lords + more settlements)
00058152	g_placement_stream     # 4-byte {x,y,id,kind} records; kind $10 = lord, <$10 = player start, 0 = end
0001ba3e	pm_sound_mix           # sample-table mix into the audio buffers
0001a856	pm_sound_cue           # ambient sound cue (bleat / call)

# ---- economy: goods / livestock / settlements (economy.md, 74th-75th pass) ----
# pm_leader ($4e514, stride 32): +0 side, +2 chain_head->g_settlement_table, +4 cell, +6 troops_reserve,
#   +8 troops_field, +12 gather_kind, +14 loyalty_pressure (>=600 -> $550e defection), +16 herd_throttle,
#   +20 shepherd_obj, +22 nearest_herd, +24..31 goods[8] = Pike/Sword/Bow/Plough/Boat/Pot/Catapult/Cannon counts
0004d252	g_trees               # tree array (`_trees`), stride 12, live length $4e512, cap 400. +2 worker obj (nothing natural sets it), +6 cat $4 (the byte6-4 render category), +7 tree_state $e-$11 / $0d felled, +8 next tree of the forest, +10 packed cell = liveness. 203/203 on byte6 4 records (py/tree_census.py)
0004e512	g_tree_count          # live byte-length of g_trees (init $c, += $c per tree)
00057f68	g_forests             # forest operations (`_forests`), stride 8, <=10 (ends at $57fb8). +0 target cell, +4 -> g_trees (first tree), +6 -> g_birds
0004c5f4	g_birds               # forest markers (`_birds`), stride 22, <=80 (ends at $4ccd4). +15 signed progress, +20 chain link. COSMETIC ONLY (what they show on screen is not established)
00004342	pm_forest_service      # `_do_fore...`, per-tick (from $3e06): animate the forest markers; at arrival ($44c6) just sets tree_state bit7 + unlinks the marker sprite. NO economic effect. Proven 8/9 branches (113th, ai.md); no-op in every natural capture
00004672	pm_world_features_seed # `_setup_f...`: world-build: scatter 10 forests (clusters of trees) + markers over buildable cells
00004788	pm_seed_tree           # `place_tr...`: place one g_trees entry on a buildable land cell; link it into a g_forests entry
00005ec6	pm_work_assign         # tail of $5cde: hand the lord's work (mode, deposit object, start value) to every living non-leader man of his settlements; forest op -> 20(lord)
000155ac	h_mode3e_find_tree     # `head_for...`: first unfelled tree of the lord's forest chain (skipping 14(man)&3) -> target, mode $10, prev $44
000156be	h_mode44_fell          # `at_fores...`: 4-tick countdown then tree_state := $0d (felled); head to the deposit object, prev $42
00015736	h_mode42_deliver       # `at_works`: arrival at the deposit object -> $600a
0000600a	pm_deliver_dispatch    # dispatch on leader.gather_kind ($6062 table: 2/6/8/a/e fell trees ($3e), 4 workshop loop ($40), c field path ($0c)); every non-idle case -> $60dc; non-leader men cost the lord 2 food
000060dc	pm_deliver_goods       # THE payoff: throttled by leader+16 (reload $580a6[side].word8+4, +$2000 if kind>=$e); leader.goods[(kind>>1)-1] += 1 (cap $ff)
000159de	pm_porter_pickup       # r = $57fec%6; src_leader.goods[r] -= 1; stamp code (r+1)*2 onto porter byte 44 (r<3) / byte 33
000159a4	pm_porter_dropoff      # read carried code off byte 33/44; dst_leader.goods[(code>>1)-1] += 1 (cap $ff); clear the byte
00015a60	h_mode50_deposit       # porter FSM: arrive at leader, $159a4, -> mode $52
00015ad2	h_mode54_pickup        # porter FSM: walk to a nation leader, $159de, -> mode $50
00015a0e	h_mode4e_deposit       # porter FSM: $159a4 into the settlement's owner leader -> mode $54 (or, iff word[$57fd0]==0, dwell:=#$ff9d + mode $7c -- same rotating $57fd0 gate as mode $16 $15042 and $15b7a; 97th: this is one of the 3 paths that spawn the natural $7c markers in pm97_map0, prev_mode $4e)
000061f8	pm_army_supply         # mode $6e (from $15740): spend leader.goods[i] >> discipline into group supply_acc, -> $6352/$638c, then $35f4
00006352	pm_supply_push         # add to group-order supply_acc[i] (word[84 + i*12]); overflow -> $638c
0000638c	pm_equip_unit          # if unit tier slot ($21 items>6 / $2c items<=6) < delivered item -> upgrade; recycle displaced item. THIS IS "INVENTION"
000063f4	pm_supply_deposit      # mode $78: supply_acc[] -> leader.goods[] (cap $ff), then free the group slot
000033b0	pm_prosperity_trigger  # mode $76: weighted this-tick delivery total + assessment byte - 2 >= 0 -> attack order $2a / $34a8 declare war. economy->strategy coupling
00003498	t_supply_weights       # data: 8 words, per-resource weight for the $33b0 prosperity sum
0000a242	t_item_names           # data: string table, entries 1..8 = Pike/Sword/Bow/Plough/Boat/Pot/Catapult/Cannon
000157e6	h_mode7c_stay_at	# orig stay_at_: per-settlement heartbeat body. 96th RIDER 3b: PROVEN vs real 68k (85/85 tracked bytes over 25 states, 12 branch families; scratchpad/pm96/). subi.w #$1,18(A1) bgt -> next (no epilogue); jsr $16848 + jsr $5c80 (x2); D5 := post-dec dwell; 18(A1) := $580a6[side*$20].word0 reload; jsr $163b8; btst#4 7(A1) -> epilogue; 7(settl)==$a -> 16(settl)++ (>=$78: nation_kind := dest_cell%10, ==7 -> kind:=$10, 16:=0); troops_field*4: ==0 -> epilogue / >=reserve -> (D5==$ff9c: loyalty+=2) / <reserve -> (D5==$ff9c: loyalty-=1) then (14(A1)&3)!=3 -> $5cde; loyalty>=$258 -> $550e; epilogue $161c4. $5cde/$550e/$5c2c ASSERTED OFF. Loyalty only moves when D5==$ff9c (first pulse after a #$ff9d-dwell park), NOT every pulse
00016848	pm_side_reconcile      # 96th: settlement.owner (5(A3), A3=$4f916+34(A1)) vs marker.side (5(A1)): equal -> skip; else btst#7 clear + btst#4 clear -> 5(A1):=owner (adopt); btst#4 set -> jsr $5c2c. Then if 24(A1)!=0 && 24(A1)==0(A1): $57ff4 := 24(A1). Tail jsr $5c80. Also the mode-$16 ($15042) prologue call. PROVEN in the 96th mode-$7c test ($5c2c arm asserted off)
000163b8	pm_settlement_upkeep   # RIDER 3b: PROVEN vs real 68k (96th synthesised 85/85, 97th natural 99/99). settlement.leader.troops_reserve -= 1, floored at 0 (settlement = $4f916+34(A1), leader = $4e514 + word[settl+14]). movem saves/restores A0 only. Per-settlement manpower drain / desertion -- fires via mode $7c, i.e. in mission 1 only during the intermittent $57fd0==0 phases ($1abaa rotation)
0000550e	pm_revolt              # loyalty_pressure >= 600: lord + all its settlements defect to side (marker.field8 % 4)+1; reset loyalty to $12c (300). ASSERTED OFF in the mode-$7c proof (loyalty kept < 600); reached only from mode $7c. 97th: in pm97_map0 both AI lords climbed 300 -> 316/318 in 80M steps (field*4=40 > reserve=0 -> +2/pulse), so 600 is within reach of a long game when $57fd0 rotation favours $7c
00005cde	pm_settlement_workorder # `_set_tow...`: the lord's work order (from mode $7c, field*4<food && (anim&3)!=3, and from order $0e via $5fa0): walks the nation's settlement chain for the capital, scans $57f68 forest ops + the $3f86c control byte, may allocate a $4f916 record ($51536 += $12) + $16808, then $5ec6 stamps the men. Proven 768/768 (diff_5cde.py)
00003bc0	pm_group_return_men    # group teardown: leader.troops_reserve += group.force >> discipline
