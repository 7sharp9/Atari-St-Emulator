00011f1a	pm_entity_cell_lerp     # 87th: bilinear lerp of the 4 projected cell corners (a0=&$3f364[cellRow*64+cellCol*4]; C00/C10/C01/C11) by (record[8]&0xff, record[10]&0xff); then screenX+=$3c, screenY-=8
